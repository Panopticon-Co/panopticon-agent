{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panopticon.local/schema/officer/event-0.5.json",
  "title": "Panopticon Officer telemetry event",
  "description": "The V5 normalized endpoint telemetry contract. Additive over Schema 0.4: all prior event shapes, families and source kinds remain valid and byte-identical. 0.5 adds process stop events (Sysmon 5) and four families: dns (Sysmon 22), process_access (Sysmon 10), remote_thread (Sysmon 8) and script_block (PowerShell 4104). An event of a 0.5 family or type declares schema_version 0.5; an event of an older family keeps the version that introduced it. Every event still carries a process context block: for process_access and remote_thread it is the SOURCE process, and the target is in the family block.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event", "source", "agent", "host", "user", "process"],
  "properties": {
    "schema_version": { "enum": ["0.2", "0.3", "0.4", "0.5"] },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "type", "timestamp"],
      "properties": {
        "id": { "type": "string", "pattern": "^evt_[0-9a-f]{64}$" },
        "category": {
          "enum": ["process", "network", "file", "registry", "image_load", "dns", "process_access", "remote_thread", "script_block"]
        },
        "type": { "type": "string", "minLength": 1 },
        "timestamp": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "channel", "record_id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["etw", "sysmon", "windows_event_log", "linux_procfs"]
        },
        "provider": { "type": "string", "minLength": 1 },
        "channel": { "$ref": "#/$defs/nullableString" },
        "record_id": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "hostname", "os"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "hostname": { "type": "string", "minLength": 1 },
        "os": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "build"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "build": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "domain", "sid"],
      "properties": {
        "name": { "$ref": "#/$defs/nullableString" },
        "domain": { "$ref": "#/$defs/nullableString" },
        "sid": { "$ref": "#/$defs/nullableString" }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "pid", "name", "executable", "command_line", "parent", "hash"],
      "properties": {
        "entity_id": { "$ref": "#/$defs/processEntityId" },
        "pid": { "$ref": "#/$defs/pid" },
        "name": { "$ref": "#/$defs/nullableString" },
        "executable": { "$ref": "#/$defs/nullableString" },
        "command_line": { "$ref": "#/$defs/nullableString" },
        "start_time_ticks": { "$ref": "#/$defs/nullableStartTimeTicks" },
        "parent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entity_id", "pid", "name"],
          "properties": {
            "entity_id": {
              "oneOf": [
                { "$ref": "#/$defs/processEntityId" },
                { "type": "null" }
              ]
            },
            "pid": {
              "oneOf": [
                { "$ref": "#/$defs/pid" },
                { "type": "null" }
              ]
            },
            "name": { "$ref": "#/$defs/nullableString" }
          }
        },
        "hash": { "$ref": "#/$defs/sha256Hash" }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "description": "Sysmon EventID 3. Connection metadata only - no payload, no packet capture.",
      "required": ["direction", "protocol", "source_ip", "source_port", "destination_ip", "destination_port", "destination_hostname"],
      "properties": {
        "direction": { "enum": ["inbound", "outbound"] },
        "protocol": {
          "oneOf": [
            { "enum": ["tcp", "udp"] },
            { "type": "null" }
          ]
        },
        "source_ip": { "$ref": "#/$defs/nullableString" },
        "source_port": { "$ref": "#/$defs/nullablePort" },
        "destination_ip": { "$ref": "#/$defs/nullableString" },
        "destination_port": { "$ref": "#/$defs/nullablePort" },
        "destination_hostname": { "$ref": "#/$defs/nullableString" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "description": "Sysmon EventID 11 (create), 23/26 (delete). Metadata only - file contents are never read.",
      "required": ["operation", "path", "target_path", "previous_path", "hash"],
      "properties": {
        "operation": { "enum": ["create", "delete", "rename"] },
        "path": { "$ref": "#/$defs/nullableString" },
        "target_path": { "$ref": "#/$defs/nullableString" },
        "previous_path": { "$ref": "#/$defs/nullableString" },
        "hash": { "$ref": "#/$defs/sha256Hash" }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "description": "Sysmon EventID 12 (key add/delete), 13 (value set), 14 (rename). value_data is metadata-only and defaults to null; value contents are not collected unless a rule needs them.",
      "required": ["operation", "key_path", "value_name", "value_type", "value_data"],
      "properties": {
        "operation": { "enum": ["add_key", "delete_key", "set_value", "rename_key"] },
        "key_path": { "$ref": "#/$defs/nullableString" },
        "value_name": { "$ref": "#/$defs/nullableString" },
        "value_type": { "$ref": "#/$defs/nullableString" },
        "value_data": { "$ref": "#/$defs/nullableString" }
      }
    },
    "image_load": {
      "type": "object",
      "additionalProperties": false,
      "description": "Sysmon EventID 7. Module/image load metadata; no memory dumping, no PE analysis.",
      "required": ["path", "is_signed", "signature_status", "hash"],
      "properties": {
        "path": { "$ref": "#/$defs/nullableString" },
        "is_signed": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "signature_status": { "$ref": "#/$defs/nullableString" },
        "hash": { "$ref": "#/$defs/sha256Hash" }
      }
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "description": "Sysmon EventID 22 (Schema 0.5). One DNS query made by the process-context process. query_results is the resolver's answer string exactly as Sysmon renders it (e.g. 'type:  5 cdn.example;::ffff:93.184.216.34;'); it is not parsed or reordered here.",
      "required": ["query_name", "query_status", "query_results"],
      "properties": {
        "query_name": { "$ref": "#/$defs/nullableString" },
        "query_status": { "$ref": "#/$defs/nullableUInt32" },
        "query_results": { "$ref": "#/$defs/nullableString" }
      }
    },
    "process_access": {
      "type": "object",
      "additionalProperties": false,
      "description": "Sysmon EventID 10 (Schema 0.5). The process-context process (source) opened a handle to target. granted_access is the access mask as Sysmon renders it (hex string). call_trace is Sysmon's module+offset stack string, unmodified.",
      "required": ["target", "granted_access", "call_trace"],
      "properties": {
        "target": { "$ref": "#/$defs/targetProcess" },
        "granted_access": { "$ref": "#/$defs/nullableHex" },
        "call_trace": { "$ref": "#/$defs/nullableString" }
      }
    },
    "remote_thread": {
      "type": "object",
      "additionalProperties": false,
      "description": "Sysmon EventID 8 (Schema 0.5). The process-context process (source) created a thread in target. start_module and start_function are null when Sysmon reports '-', i.e. the thread starts in memory no loaded module backs.",
      "required": ["target", "new_thread_id", "start_address", "start_module", "start_function"],
      "properties": {
        "target": { "$ref": "#/$defs/targetProcess" },
        "new_thread_id": { "$ref": "#/$defs/nullableUInt32" },
        "start_address": { "$ref": "#/$defs/nullableHex" },
        "start_module": { "$ref": "#/$defs/nullableString" },
        "start_function": { "$ref": "#/$defs/nullableString" }
      }
    },
    "script_block": {
      "type": "object",
      "additionalProperties": false,
      "description": "Microsoft-Windows-PowerShell/Operational EventID 4104 (Schema 0.5). One script block (or one part of a multi-part block: message_number of message_total) compiled by the process-context PowerShell host. text carries at most the first 16384 UTF-8 bytes of the block, cut on a character boundary; text_length is the full block's length in UTF-8 bytes, text_truncated says whether text is shorter, and text_sha256 hashes the full block. The event carries no image path; process.executable is filled only from what the agent already observed for that PID.",
      "required": ["script_block_id", "message_number", "message_total", "path", "text", "text_length", "text_truncated", "text_sha256"],
      "properties": {
        "script_block_id": { "$ref": "#/$defs/nullableString" },
        "message_number": { "$ref": "#/$defs/nullableUInt32" },
        "message_total": { "$ref": "#/$defs/nullableUInt32" },
        "path": { "$ref": "#/$defs/nullableString" },
        "text": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 16384 },
            { "type": "null" }
          ]
        },
        "text_length": { "type": "integer", "minimum": 0 },
        "text_truncated": { "type": "boolean" },
        "text_sha256": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "event": { "properties": { "category": { "const": "process" } } } } },
      "then": { "properties": { "event": { "properties": { "type": { "enum": ["start", "stop"] } } } } }
    },
    {
      "if": { "properties": { "event": { "properties": { "category": { "const": "dns" } } } } },
      "then": {
        "required": ["dns"],
        "properties": { "event": { "properties": { "type": { "enum": ["query"] } } } }
      }
    },
    {
      "if": { "properties": { "event": { "properties": { "category": { "const": "process_access" } } } } },
      "then": {
        "required": ["process_access"],
        "properties": { "event": { "properties": { "type": { "enum": ["access"] } } } }
      }
    },
    {
      "if": { "properties": { "event": { "properties": { "category": { "const": "remote_thread" } } } } },
      "then": {
        "required": ["remote_thread"],
        "properties": { "event": { "properties": { "type": { "enum": ["create"] } } } }
      }
    },
    {
      "if": { "properties": { "event": { "properties": { "category": { "const": "script_block" } } } } },
      "then": {
        "required": ["script_block"],
        "properties": { "event": { "properties": { "type": { "enum": ["execute"] } } } }
      }
    },
    {
      "if": { "properties": { "event": { "properties": { "category": { "const": "network" } } } } },
      "then": {
        "required": ["network"],
        "properties": { "event": { "properties": { "type": { "enum": ["connect"] } } } }
      }
    },
    {
      "if": { "properties": { "event": { "properties": { "category": { "const": "file" } } } } },
      "then": {
        "required": ["file"],
        "properties": { "event": { "properties": { "type": { "enum": ["create", "delete", "rename"] } } } }
      }
    },
    {
      "if": { "properties": { "event": { "properties": { "category": { "const": "registry" } } } } },
      "then": {
        "required": ["registry"],
        "properties": { "event": { "properties": { "type": { "enum": ["add_key", "delete_key", "set_value", "rename_key"] } } } }
      }
    },
    {
      "if": { "properties": { "event": { "properties": { "category": { "const": "image_load" } } } } },
      "then": {
        "required": ["image_load"],
        "properties": { "event": { "properties": { "type": { "enum": ["load"] } } } }
      }
    }
  ],
  "$defs": {
    "nullableString": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "pid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "nullablePort": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 65535 },
        { "type": "null" }
      ]
    },
    "nullableStartTimeTicks": {
      "description": "Opaque, OS-native process-creation value the producing agent already computes for its own PID-reuse defense (Linux: /proc/[pid]/stat field 22, clock ticks since boot; Windows: GetProcessTimes creation FILETIME). Never interpreted as a duration or wall-clock time by any consumer other than the originating host's own agent -- see panopticon-response-engine/docs/adr/002-terminate-process-start-time-threading.md.",
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "null" }
      ]
    },
    "processEntityId": {
      "type": "string",
      "pattern": "^proc_[0-9a-f]{64}$"
    },
    "nullableUInt32": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        { "type": "null" }
      ]
    },
    "nullableHex": {
      "oneOf": [
        { "type": "string", "pattern": "^0x[0-9a-fA-F]+$" },
        { "type": "null" }
      ]
    },
    "targetProcess": {
      "type": "object",
      "additionalProperties": false,
      "description": "The other process in a cross-process event. entity_id is derived the same way as a process-context entity_id (host + pid + the source's process GUID), so it is a traceability id, not a join key across families.",
      "required": ["entity_id", "pid", "executable", "user"],
      "properties": {
        "entity_id": {
          "oneOf": [
            { "$ref": "#/$defs/processEntityId" },
            { "type": "null" }
          ]
        },
        "pid": {
          "oneOf": [
            { "$ref": "#/$defs/pid" },
            { "type": "null" }
          ]
        },
        "executable": { "$ref": "#/$defs/nullableString" },
        "user": { "$ref": "#/$defs/nullableString" }
      }
    },
    "sha256Hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
