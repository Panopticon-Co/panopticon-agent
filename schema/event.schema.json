{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panopticon.local/schema/officer/event-0.1.json",
  "title": "Panopticon Officer process event",
  "description": "The frozen Phase 1 normalized process-start contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event", "agent", "host", "user", "process"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "type", "timestamp"],
      "properties": {
        "id": { "type": "string", "pattern": "^evt_[0-9a-f]{64}$" },
        "category": { "const": "process" },
        "type": { "const": "start" },
        "timestamp": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "hostname", "os"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "hostname": { "type": "string", "minLength": 1 },
        "os": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "build"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "build": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "domain", "sid"],
      "properties": {
        "name": { "$ref": "#/$defs/nullableString" },
        "domain": { "$ref": "#/$defs/nullableString" },
        "sid": { "$ref": "#/$defs/nullableString" }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "pid", "name", "executable", "command_line", "parent", "hash"],
      "properties": {
        "entity_id": { "$ref": "#/$defs/processEntityId" },
        "pid": { "$ref": "#/$defs/pid" },
        "name": { "$ref": "#/$defs/nullableString" },
        "executable": { "$ref": "#/$defs/nullableString" },
        "command_line": { "$ref": "#/$defs/nullableString" },
        "parent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entity_id", "pid", "name"],
          "properties": {
            "entity_id": {
              "oneOf": [
                { "$ref": "#/$defs/processEntityId" },
                { "type": "null" }
              ]
            },
            "pid": {
              "oneOf": [
                { "$ref": "#/$defs/pid" },
                { "type": "null" }
              ]
            },
            "name": { "$ref": "#/$defs/nullableString" }
          }
        },
        "hash": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256"],
          "properties": {
            "sha256": {
              "oneOf": [
                { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                { "type": "null" }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nullableString": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "pid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "processEntityId": {
      "type": "string",
      "pattern": "^proc_[0-9a-f]{64}$"
    }
  }
}
